{
  "name": "pdf-editor",
  "version": "2.0.0-dev",
  "private": true,
  "description": "PDF-Editor für den Browser – eine einzige HTML-Datei, läuft offline.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "fixtures": "node tests/fixtures/generate.mjs",
    "test": "playwright test",
    "format": "prettier --write src scripts tests"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.9"
  }
}
